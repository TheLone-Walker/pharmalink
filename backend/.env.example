# ─── PharmaLink Environment Configuration ──────────────────────────────

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/pharmalink"

# JWT Authentication
JWT_SECRET="your_jwt_secret_key"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── SMTP Email Configuration ──────────────────────────────────────────
# For custom SMTP (e.g. Hostinger, SendGrid, Mailgun, Amazon SES):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_specific_password"
SMTP_FROM='"PharmaLink Healthcare" <noreply@pharmalink.cm>'

# Or for Gmail direct service:
# SMTP_SERVICE="gmail"
# GMAIL_USER="your_email@gmail.com"
# GMAIL_APP_PASSWORD="your_16_digit_app_password"

# ─── Google Maps API ──────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# ─── Payments (DigiPay / Campay / Mobile Money) ────────────────────────
PAYMENT_PROVIDER="digipay" # "digipay" | "campay" | "simulation"
DIGIPAY_API_KEY="your_digipay_or_campay_api_token"
DIGIPAY_API_SECRET="your_digipay_api_secret"
DIGIPAY_API_URL="https://api.campay.net/api"

# ─── AI Assistant (Google Gemini) ──────────────────────────────────────
GEMINI_API_KEY="your_gemini_api_key_here"

# ─── SMS (Africa's Talking) ───────────────────────────────────────────
SMS_PROVIDER="africas_talking"
SMS_API_KEY="your_africas_talking_api_key"
SMS_USERNAME="sandbox"

# ─── Server Configuration ──────────────────────────────────────────────
PORT=3000
CLIENT_URL="*"
NODE_ENV="development"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=5242880
